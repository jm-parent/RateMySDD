{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratemysdd.local/contracts/typed-audit-output.schema.json",
  "title": "AiTypedAuditOutput",
  "description": "Sortie JSON exigée de l'IA pour un audit plan ou tasks. Le score global est calculé par le serveur.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluations"],
  "properties": {
    "evaluations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/evaluation" }
    }
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "score", "summary", "description", "improvements"],
      "properties": {
        "criterionId": { "enum": ["01", "02", "03", "04", "05", "06"] },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "0 = absent, 1-24 très insuffisant, 25-49 insuffisant, 50-69 acceptable, 70-89 bon, 90-100 excellent"
        },
        "summary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 180 }
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "improvements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}