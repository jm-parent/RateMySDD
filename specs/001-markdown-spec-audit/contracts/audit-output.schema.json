{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ratemysdd.local/contracts/audit-output.schema.json",
  "title": "AiAuditOutput",
  "description": "Sortie JSON exigée de l'IA pour un audit (FR-011 à FR-015). Le score global n'en fait PAS partie : il est calculé par le serveur.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pillars"],
  "properties": {
    "pillars": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "$ref": "#/$defs/evaluation", "properties": { "pillarId": { "const": "01" } } },
        { "$ref": "#/$defs/evaluation", "properties": { "pillarId": { "const": "02" } } },
        { "$ref": "#/$defs/evaluation", "properties": { "pillarId": { "const": "03" } } },
        { "$ref": "#/$defs/evaluation", "properties": { "pillarId": { "const": "04" } } },
        { "$ref": "#/$defs/evaluation", "properties": { "pillarId": { "const": "05" } } },
        { "$ref": "#/$defs/evaluation", "properties": { "pillarId": { "const": "06" } } }
      ],
      "items": false
    }
  },
  "$defs": {
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pillarId", "score", "summary", "description", "improvements"],
      "properties": {
        "pillarId": { "enum": ["01", "02", "03", "04", "05", "06"] },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "0 = absent, 1-24 très insuffisant, 25-49 insuffisant, 50-69 acceptable, 70-89 bon, 90-100 excellent"
        },
        "summary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 180 },
          "description": "Un à trois constats brefs, factuels et directement dérivés de la description complète"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Constat factuel en français de ce que le document couvre et ne couvre pas pour ce pilier"
        },
        "improvements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 },
          "description": "Recommandations concrètes et actionnables en français ; si aucune, un unique élément explicite"
        }
      }
    }
  }
}
